# KiCad
*-backups/
*.kicad_prl
fp-info-cache
_autosave-*
*.lck
~*.lck
\#auto_saved_files#
hardware/kicad/*.net
# build / caches
build/
validation/.cache/
tools/freerouting/*.jar
__pycache__/
*.pyc
.venv/
.DS_Store
# firmware dependency downloads (cmake FetchContent cache)
firmware/.deps/
# analog sims: vendor SPICE models are fetched (no redistribution rights), raw sim data is large
validation/sim/models/vendor/
validation/sim/out/*
!validation/sim/out/*.png
!validation/sim/out/summary.txt

# enclosure: STLs are regenerated from enclosure.py (STEP is committed)
hardware/enclosure/out/*.stl
# canlog: raw vehicle captures are large; keep them local. The small .json/.marks
# session summaries (which carry the decoded findings) are committed.
tools/canlog/logs/*.log
tools/canlog/logs/*.raw
# Claude Code personal settings
.claude/settings.local.json
