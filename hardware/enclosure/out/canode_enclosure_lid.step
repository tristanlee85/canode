#65512 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) 
GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#65516)) 
GLOBAL_UNIT_ASSIGNED_CONTEXT((#65513,#65514,#65515)) 
REPRESENTATION_CONTEXT('Context #1',
  '3D Context with UNIT and UNCERTAINTY') );
#65513 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#65514 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#65515 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#65516 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(2.E-06),#65513,
  'distance_accuracy_value','confusion accuracy');
#65517 = CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#65518,#65520);
#65518 = ( REPRESENTATION_RELATIONSHIP('','',#32,#10) 
REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#65519) 
SHAPE_REPRESENTATION_RELATIONSHIP() );
#65519 = ITEM_DEFINED_TRANSFORMATION('','',#11,#15);
#65520 = PRODUCT_DEFINITION_SHAPE('Placement','Placement of an item',
  #65521);
#65521 = NEXT_ASSEMBLY_USAGE_OCCURRENCE('2','=>[0:1:1:2]','',#5,#27,$);
#65522 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#29));
